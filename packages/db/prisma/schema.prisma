generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  backlog
  ready
  blocked
  assigned
  running
  verifying
  reviewing
  merging
  rework
  done
  failed
  cancelled
  /// M36 t2: waiting for another slave to answer a question. Distinct from `blocked`, which since
  /// M35 means "a human must look at this" and is left only by `unblock-task`; this one resolves
  /// itself when the answer arrives. Not startable (`decide.ts`'s `STARTABLE`), and not reset by
  /// the sweep -- the asking run is `paused`, which the orphan pass leaves alone.
  waiting
}

enum RunStatus {
  starting
  working
  pause_requested
  paused
  resuming
  stopping
  stopped
  succeeded
  failed
}

enum Actor {
  human
  slave
  system
}

/// verifyCommands/setupCommands are NOT NULL at the database level, a deliberate departure from
/// Prisma's own DDL convention for a required String[] with no @default (which is a plain
/// nullable column). An empty verifyCommands is not a neutral default here — it is a refusal to
/// ever let a task on this workspace verify as complete, so a caller that forgets the field must
/// fail loudly at creation rather than silently getting `[]`. See the m3_runs_checkpoints_commands
/// migration for the DDL that enforces this.
model Workspace {
  id                      String    @id @default(uuid())
  /// Unique as of M23 A1: a workspace is addressed by name from the CLI and the Settings form,
  /// so two rows sharing a name would make that addressing permanently ambiguous.
  name                    String    @unique
  repoPath                String
  baseBranch              String    @default("main")
  verifyCommands          String[]
  setupCommands           String[]
  autoMerge               Boolean   @default(false)
  haltedReason            String?
  haltedAt                DateTime?
  /// M27: an archived project keeps every row but leaves every list and the scheduler (spec §3).
  archivedAt              DateTime?
  /// The operator's standing instruction for what this workspace's slaves are working toward
  /// (M8b). Read by the planner (Task 4) and written by the workspace settings UI (Task 6) --
  /// unlike `verifyCommands`/`setupCommands` above, an unset goal is a perfectly ordinary state
  /// (no planning run has run yet), so this stays on Prisma's conventional nullable-String DDL.
  goal                    String?
  /// M40 §1: which `GoalVersion` row the `goal` cache above IS -- the latest version, mirrored on
  /// the workspace so a reader never has to aggregate the history table. Backfilled to 1 for every
  /// workspace that already had a goal when the migration ran.
  ///
  /// 0 means "no version recorded", which since M40 Task 2 is exactly "the goal has never been
  /// set": `setGoal` is the only writer of `goal`, and it inserts version `goalVersion + 1` under
  /// a row lock and moves this column in the same transaction. A row hand-seeded straight into the
  /// table with a `goal` and no version is the one remaining way to be 0 with a real goal; every
  /// reader tolerates it -- nothing treats 0 as "unset" beyond reporting no version.
  goalVersion             Int       @default(0)
  /// The company assigned to run this project (M10 §5), nullable: the engine never required a
  /// company, and existing seeded workspaces keep their hand-made teams/slaves untouched
  /// (Decision 7). Assignment is one-way in M10 -- no un-assignment or re-assignment to a
  /// different company (Decision 2) -- so this column only ever moves from null to set.
  companyId               String?
  /// Who set the current goal (M23 F6), nullable: the CLI and the orchestrator act with no user,
  /// and every workspace created before this column existed reads back null. `onDelete: SetNull`
  /// -- a workspace must survive the deletion of the account that once set its goal.
  goalSetByUserId         String?
  /// M33: the simulation run this workspace's organisation was adopted from; null for every
  /// workspace assigned by hand. SetNull: deleting the run must not touch the project.
  adoptedFromSimulationId String?

  /// M38 section 1: a workspace may only NARROW the Supervisor, never widen it. `false` means
  /// report only -- `recordDecision` refuses `supervisor_disabled` and nothing is ever applied or
  /// proposed. Defaults to true: an existing project gets a Supervisor the moment this milestone
  /// lands, which is the point of it.
  supervisorEnabled Boolean @default(true)
  /// The persona and standing rules prepended to the decision prompt (M38 section 2). Same shape
  /// and same limits as M37's profiles: `PROFILE_MAX_CHARS` on write and `neutraliseMarkers` on
  /// render. Null is the ordinary state -- the rules decide perfectly well without one.
  supervisorProfile String?
  /// M48 R5: the runbook this project has adopted, or null. SetNull: deleting a runbook must not
  /// destroy a project. Adopting after tasks exist is allowed -- the next re-plan sees it.
  runbookId String?

  maxConcurrentRuns       Int    @default(3)
  /// The spend ceiling this workspace's budget guardrail enforces (spec §9.2). Nullable as of
  /// M12 Task 9, and the `@default(20)` deliberately STAYS: a workspace is budgeted unless an
  /// operator deliberately clears it, so no existing row moves and every new one is guarded
  /// exactly as it is today. `null` means "this workspace is not budgeted", which spec §6 makes
  /// the ONLY state in which a cost-blind runtime (`ProviderCapabilities.reportsCost === false`)
  /// may run: the guardrail is real or it is absent, never silently inert. Dropping the default
  /// instead would leave every newly created workspace unguarded -- strictly worse than the bug
  /// this column's nullability exists to fix.
  budgetUsd               Float? @default(20)
  runTimeoutMs            Int    @default(1800000)
  maxToolCallsPerRun      Int    @default(200)
  maxAttempts             Int    @default(3)
  consecutiveFailureLimit Int    @default(3)

  createdAt DateTime @default(now())

  // No explicit onDelete: `deleteCompany` (M27 §5) detaches an assigned project's `companyId`
  // itself, inside its own transaction, so it can COUNT what it detached before the row is gone --
  // this optional relation keeps Prisma's Postgres default for an optional FK -- SetNull -- rather
  // than a Cascade that would destroy a project's history.
  company               Company?       @relation(fields: [companyId], references: [id])
  goalSetByUser         User?          @relation(fields: [goalSetByUserId], references: [id], onDelete: SetNull)
  adoptedFromSimulation SimulationRun? @relation("SimulationAdoption", fields: [adoptedFromSimulationId], references: [id], onDelete: SetNull)
  runbook               RunbookTemplate? @relation(fields: [runbookId], references: [id], onDelete: SetNull)

  teams                  Team[]
  providerConfigurations ProviderConfiguration[]
  tasks                  Task[]
  supervisorDecisions    SupervisorDecision[]
  goalVersions           GoalVersion[]
  /// M49 R1: what this PROJECT knows (`scope: workspace`).
  memories               Memory[]

  @@index([adoptedFromSimulationId])
}

/// One immutable version of a workspace's goal (M40 §2). `setGoal` never overwrites history: it
/// inserts a row here with `version = Workspace.goalVersion + 1` and updates the workspace's cache
/// in the same transaction. `sha256` is the hash of `text` -- what `setGoal` compares a new goal
/// against to refuse `goal_unchanged`, and what a run's `planning_goal` section records so a plan
/// can be traced to the exact requirement text that produced it.
model GoalVersion {
  id          String   @id @default(uuid())
  workspaceId String
  version     Int
  text        String
  sha256      String
  /// Who set it, nullable for the same reason as `Workspace.goalSetByUserId`: the CLI and the
  /// orchestrator act with no user, and the backfilled v1 rows carry whatever that column held.
  setByUserId String?
  /// M45 R3: the words a person typed into "Tell the Supervisor", when this version was made by
  /// `requestChange` rather than by a whole-goal `setGoal`. Null is a real value and the common
  /// one: every version written before M45, and every version written by the Settings editor or
  /// by `set-goal`, was a statement of the goal rather than a request to change it.
  request     String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The version sequence is per workspace, and it is the constraint that makes two concurrent
  /// `setGoal` calls impossible to interleave into a duplicate version rather than merely unlikely.
  @@unique([workspaceId, version])
}

model Team {
  id            String  @id @default(uuid())
  workspaceId   String
  name          String
  /// The roster link (M11): null for legacy hand-made teams created before the organization
  /// model, or for a team whose roster row has since been deleted. `assignCompany` matches
  /// project teams by this id first, adopting (stamping) a legacy same-named team on first
  /// assign rather than duplicating it. `onDelete: SetNull` (not Cascade), mirroring
  /// `Slave.companySlaveId`: a team with run history must survive its roster row's deletion.
  companyTeamId String?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyTeam CompanyTeam? @relation(fields: [companyTeamId], references: [id], onDelete: SetNull)
  slaves      Slave[]

  /// M34 t2: a department name is unique per project. `createProjectTeam`/`renameTeam` still run
  /// a friendly pre-check first (it names the sibling in the refusal), but this index is what
  /// actually closes the race a read-then-write pre-check cannot -- both verbs also catch
  /// `isUniqueConstraintViolation` (P2002) on this index, the rule `org.ts`'s catalog verbs already
  /// follow for their own `@@unique` indexes.
  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// M50 R1: why a worker exists -- the closed set `SLAVE_LIFECYCLES` in
/// `packages/domain/src/lifecycle/types.ts` mirrors, pinned member-for-member by
/// `packages/db/test/integration/enum-parity.test.ts`.
enum SlaveLifecycle {
  /// Materialised from a company roster row: this worker exists in the organisation.
  permanent
  /// Hired for this project.
  project
  /// Brought in for ONE assignment (`engagementTaskId`), and released when it is over.
  ephemeral
}

model Slave {
  id             String        @id @default(uuid())
  teamId         String
  name           String
  /// The profile's title -- display and persona only (M37 t1). No longer what the scheduler,
  /// review pass or planning pass dispatch on; that is `runtimeRoles` now. `setSlaveRole` still
  /// writes this column, unchanged.
  role           String
  /// The roles this slave may be dispatched as (M37 t1): the scheduler match, review/manager
  /// staffing, and message role-addressing all read this set (Task 3), not `role`. Backfilled in
  /// migration `20260908190000_m37_profiles_roles` from the pre-M37 `role`/`requiredRole` pair --
  /// see that migration's own comment for the exact rule. An empty set means "cannot be
  /// dispatched" (M37 spec §2, §7); the web warns. `@default([])`, unlike
  /// `Workspace.verifyCommands`/`setupCommands`: an empty set is a real (if undispatchable) state,
  /// not a refusal, so every `slave.create()` call that predates this task keeps compiling and
  /// keeps inserting a real empty array through the migration's DB-level default.
  runtimeRoles   String[]      @default([])
  /// M47 R2: what this worker PROVIDES -- its template's normalised capabilities plus whatever an
  /// operator added (`set-capabilities`). `runtimeRoles` above is what it may be DISPATCHED as and
  /// is seeded with the roles these project to; the two are kept apart because a capability is a
  /// fact about the specialist and a runtime role is a decision about the schedule.
  capabilities   String[]      @default([])
  /// Why this worker is on this project, in one sentence a person can read (R6). Written by
  /// `hireFromTemplate`/`materialiseCompanySlave` from the Supervisor's own rationale; NULL for
  /// every worker seeded or materialised before M47, where the Organization view says "seeded" or
  /// "assigned from <company>" instead.
  selectionRationale String?
  /// The catalog row this worker was hired from (R4). `onDelete: SetNull`: a worker with run
  /// history must survive the deletion of the template it came from, exactly as `companySlaveId`
  /// survives its roster row.
  hiredFromTemplateId String?
  /// The roster link (M10): null for legacy hand-made slaves created before the organization
  /// model, or for a worker whose roster row has since been deleted. `onDelete: SetNull` (not
  /// Cascade) on the relation below is a binding ruling, not an oversight -- a worker with run
  /// history must survive its roster row's deletion; deleting a company must never cascade into
  /// deleting the runs it produced.
  companySlaveId String?
  /// The worker-level model override (M10 §6): first non-null wins in
  /// `worker.model ?? companySlave.model ?? template.defaultModel ?? null`. Legacy slaves with no
  /// roster link resolve through this column alone.
  model          String?
  /// The worker-level provider override (M12 Task 6), mirroring `model`'s resolution chain.
  /// Nullable: this task only adds the column -- Task 7/8 write and resolve it, and every
  /// existing row reads back null until then.
  provider       ProviderKind?
  /// The worker-level override of the persona Markdown (M37 §2): first non-null wins in
  /// `slave.profile ?? companySlave.profile ?? template.profile ?? null`, the same chain `model`
  /// already follows. Nullable: most workers read their profile from the roster/template.
  profile        String?
  /// M50 R1: WHY this worker exists, written at the creation site and never derived. Until this
  /// milestone three surfaces each read `companySlaveId === null ? 'project' : 'company'` for
  /// themselves, and none of them could say "this one is temporary" because no column held the
  /// fact. `assignCompanyTx` and `materialiseCompanySlave` write `permanent`; `hireFromTemplate`
  /// writes `project`, or `ephemeral` with an `engagementTaskId` when the Supervisor asked for one
  /// assignment. `@default(project)` is the honest default for a hand-made row -- the migration's
  /// one data statement corrects the roster-linked ones, which the default would call project
  /// hires.
  lifecycle          SlaveLifecycle @default(project)
  /// M50 R2: the ONE assignment an `ephemeral` worker was brought in for -- what `engagement_over`
  /// measures the end of the engagement against. `onDelete: SetNull`, the rule `companySlaveId` and
  /// `hiredFromTemplateId` already follow: a worker with run history must survive the deletion of
  /// the task it was hired for. NULL on every other lifecycle.
  engagementTaskId   String?
  /// M50 R3: when the engagement ended. NULL is "still engaged". A released worker keeps every row
  /// it ever wrote and holds no runtime roles -- that empty set is what stops `decide()` picking
  /// it, and there is no second filter anywhere.
  releasedAt         DateTime?
  /// M50 R3: the sentence the release was recorded with -- the Supervisor's own situation summary,
  /// or an operator's `--reason`.
  releaseReason      String?
  /// M50 R1: when this worker joined the project. Every row that predates this milestone reads back
  /// the migration's own timestamp, which is the only honest answer a table with no history can
  /// give -- and is why no surface presents it as a hire date.
  createdAt          DateTime @default(now())

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  companySlave CompanySlave? @relation(fields: [companySlaveId], references: [id], onDelete: SetNull)
  hiredFromTemplate SlaveTemplate? @relation("HiredWorkers", fields: [hiredFromTemplateId], references: [id], onDelete: SetNull)
  engagementTask    Task?          @relation("EngagementWorkers", fields: [engagementTaskId], references: [id], onDelete: SetNull)

  permissions SlavePermission[]
  skills      SlaveSkill[]
  runs        SlaveRun[]
  messages    SlaveMessage[]
  /// M49 R1: this WORKER's own lessons and procedures (`scope: worker`).
  memories    Memory[]

  @@index([teamId])
  /// M50 R3: `engagement_over`'s own read -- "which workers were brought in for this task".
  @@index([engagementTaskId])
}

/// The global catalog (M10 §3): role-shaped cookie cutters a company's roster is instantiated
/// from. `role` is the SAME exact-match string the scheduler, review pass and planning pass
/// already key on -- a template whose role is `reviewer` produces workers the review pass can
/// staff. No new role machinery. Templates can be deleted (M27 §5, `deleteSlaveTemplate`) -- the
/// verb removes its `CompanySlave`s first (the relation below has no cascade); project slaves
/// keep the role they were materialized with.
model SlaveTemplate {
  id            String         @id @default(uuid())
  name          String         @unique
  role          String
  description   String         @default("")
  defaultModel  String?
  /// The catalog-level provider default (M12 Task 6), sitting at the far end of the same
  /// resolution chain `defaultModel` anchors -- named `provider`, not `defaultProvider`, to match
  /// this task's migration SQL, which stamps every table's new column with the same name. Task
  /// 7/8 write and resolve it; every existing row reads back null until then.
  provider      ProviderKind?
  /// The catalog-level persona Markdown (M37 §2) -- who a worker materialized from this template
  /// is, its expertise, its working rules. Bottom of the `slave.profile ?? companySlave.profile ??
  /// template.profile ?? null` chain. Distinct from `description`, which stays the short catalog
  /// blurb; `profile` is what actually reaches a run's prompt.
  profile       String?
  /// M42 §R1: where this template came from, when it is not hand-made. `<catalog>/<division>/<slug>`
  /// -- unique, so a re-import finds the row it wrote last time no matter what the operator has
  /// since renamed. NULL for every hand-made template, which is what "imported" means here.
  sourceId       String?       @unique
  /// The SHA-256 of the persona FILE as it was imported. The change detector: an unchanged file is
  /// an unchanged row, and nothing is read or written for it.
  sourceSha256   String?
  /// The source directory this persona lived in -- the division. `role` is derived from it (R3) and
  /// may have been translated by `--role-map`, so the untranslated fact is kept separately.
  sourceDivision String?
  /// M42 erratum E2: the SHA-256 of the profile text the IMPORT wrote, which is the only way to
  /// tell an operator's edit from the import's own words. `setProfile({ templateId })` records
  /// nothing at all -- no event, no hash, deliberately, because a catalog row has no workspace to
  /// append an event to -- and `sourceSha256` cannot stand in: it hashes the FILE, and by the time
  /// this question is asked the file has changed and the body that was written is gone. A stored
  /// profile whose hash is not this one was edited (or cleared) by a person, and the import leaves
  /// it alone.
  profileSha256  String?
  /// M46 R1: the UPSTREAM structured profile -- what the importer mapped out of the persona file
  /// (`profileSpecSchema`, `packages/domain/src/profile/spec.ts`). Importer-owned: an operator
  /// never edits this column, which is exactly what makes an override survive the next import.
  /// NULL on every hand-made template and on every row imported before this milestone.
  profileSpec    Json?
  /// M46 R1: the LOCAL half -- a PARTIAL object of the same shape holding only the fields an
  /// operator changed. `effectiveProfileSpec(profileSpec, profileOverrides)` is what `profile`
  /// above is rendered from, and the two live apart so an import can rewrite one without touching
  /// the other.
  profileOverrides Json?
  /// M46 R4: the commit of the catalog checkout this row was last imported from, when the
  /// directory was inside a git work tree. NULL otherwise -- and NULL is the ordinary case for a
  /// directory somebody copied off a share.
  sourceRevision String?
  /// M46 R4: the licence named by the first line of a LICENSE file at the catalog root (`MIT
  /// License` -> `MIT`). Attribution, not a copy: no licence text is vendored anywhere.
  sourceLicense  String?
  importedAt     DateTime?
  /// M47 R1: `profileSpec.capabilities` resolved to taxonomy keys at import, so a catalog search
  /// and `formTeam` read a controlled vocabulary instead of re-normalising free text per query.
  capabilityKeys         String[] @default([])
  /// The capability sentences that matched no key, verbatim -- what the taxonomy is missing, kept
  /// where an operator can see it. Never matched against anything.
  unresolvedCapabilities String[] @default([])
  createdAt     DateTime       @default(now())
  companySlaves CompanySlave[]

  collaborationHints CollaborationHint[] @relation("CollaborationHintOwner")
  advisedBy          CollaborationHint[] @relation("CollaborationHintTarget")
  hiredWorkers       Slave[]             @relation("HiredWorkers")
  runbooks           RunbookTemplate[]   @relation("RunbookFromTemplate")
}

/// M48 R3: a reusable STAGE PLAN -- design -> implement -> verify -> review -> release, or a
/// persona's own workflow. Data, not code: `db:seed` and `syncRunbooks()` write the checked-in
/// list, `importCatalog` translates a persona's workflow into one, and `runbooks add --file` is
/// how an operator writes their own. A runbook SUGGESTS a roster (its capabilities feed team
/// formation); it never creates a team.
model RunbookTemplate {
  id                   String   @id @default(uuid())
  /// The identity everything addresses: a lower-case dash-separated slug, unique, and what the
  /// CLI, the routes and the Overview picker all name a runbook by.
  key                  String   @unique
  name                 String
  description          String
  /// Whole-word goal matching (R5). Never substrings -- see `recommendRunbooks`.
  keywords             String[] @default([])
  requiredCapabilities String[] @default([])
  optionalCapabilities String[] @default([])
  /// A validated `RunbookStage[]` (`runbookStagesSchema`). Json rather than a table: a stage has no
  /// identity outside its runbook, is never referenced by a foreign key, and is always read whole.
  stages               Json
  /// `seed` | `persona` | `human`. A sync rewrites `seed` rows and never touches the other two; an
  /// import writes `persona` rows and never overwrites a `human` one.
  source               String   @default("seed")
  /// The template a `persona` runbook was translated from. SetNull: a runbook with a workspace
  /// pointing at it must survive its persona's deletion.
  sourceTemplateId     String?
  createdAt            DateTime @default(now())
  /// The schema's first `@updatedAt` (plan erratum E14), and deliberately: `syncRunbooks()`
  /// rewrites a seed row's stages, and "when did this row last change" is the one question a
  /// reconciled table cannot answer from `createdAt`.
  updatedAt            DateTime @updatedAt

  sourceTemplate SlaveTemplate? @relation("RunbookFromTemplate", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  workspaces     Workspace[]

  @@index([source])
}

/// M47 R1: the capability taxonomy, as DATA. Nothing matches on a key that is not a row here --
/// the importer, the CLI and the planner all validate against this table, and an unknown key is
/// dropped and reported rather than stored. Seeded from `packages/db/src/capabilities.ts` by
/// `db:seed` and reconciled by `syncCapabilityTaxonomy()`; an operator adds their own with
/// `capabilities add`, and `createdBy` is what tells the two apart.
model Capability {
  /// `<domain>.<name>`, lower case and dash-separated -- the primary key, because the key IS the
  /// identity: `Task.requiredCapabilities` and `Slave.capabilities` are `String[]` columns of them
  /// (the `runtimeRoles` precedent), not foreign keys, so a taxonomy row can be relabelled without
  /// rewriting every task that asked for it.
  key        String   @id
  label      String
  /// The prefix of `key`, stored so a facet list is a `groupBy` rather than a scan of split keys.
  domain     String
  /// The runtime role this capability PROJECTS to (R2) -- the one string `decide()` matches.
  /// NOT NULL by design (plan erratum E1): a capability that projected to nothing would derive no
  /// `requiredRole`, and a task with no required role is dropped by both world loaders.
  role       String
  synonyms   String[] @default([])
  createdBy  String   @default("seed")
  createdAt  DateTime @default(now())

  @@index([domain])
}

/// M47 R5: one persona sentence, normalised into an ADVISORY relationship. Never execution
/// authority: nothing here is read by `decide()`, by the review pass or by messaging. `text` is
/// the sentence exactly as M46 stored it, which is what lets a reader trace an edge back to the
/// persona that wrote it.
model CollaborationHint {
  id               String   @id @default(uuid())
  templateId       String
  text             String
  /// The template the sentence names, when it names one. NULL is ordinary: most real handoff
  /// sentences name a generic role rather than a persona.
  targetTemplateId String?
  /// A taxonomy key the sentence is about, when it is about one. A plain column, not a relation:
  /// a hint must survive the removal of a capability row it happens to mention.
  capability       String?
  source           String   @default("import")

  template       SlaveTemplate  @relation("CollaborationHintOwner", fields: [templateId], references: [id], onDelete: Cascade)
  targetTemplate SlaveTemplate? @relation("CollaborationHintTarget", fields: [targetTemplateId], references: [id], onDelete: SetNull)

  /// One row per sentence per template -- a re-import replaces this template's hints and can never
  /// double them.
  @@unique([templateId, text])
  @@index([targetTemplateId])
}

/// A persistent roster (M10 §4) -- the durable identity ("Atlas") statistics accrue to, distinct
/// from the project-local `Slave` workers that get materialized from it. One company can serve
/// many projects (M10 Decision 2).
model Company {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  teams     CompanyTeam[]

  workspaces  Workspace[]
  simulations SimulationRun[]
  /// M49 R1: what the COMPANY knows (`scope: company`).
  memories    Memory[]
}

model CompanyTeam {
  id        String @id @default(uuid())
  companyId String
  name      String

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slaves       CompanySlave[]
  /// The project `Team` rows materialized/adopted from this roster team across every workspace
  /// it has been assigned to (M11).
  projectTeams Team[]

  @@unique([companyId, name])
}

model CompanySlave {
  id            String        @id @default(uuid())
  companyTeamId String
  templateId    String
  /// The durable identity -- "Atlas" -- statistics and history accrue to this name across every
  /// project the company is assigned to, even though each project gets its own materialized
  /// worker `Slave` row.
  name          String
  /// Roster-level override of the template default (M10 §6): sits between
  /// `SlaveTemplate.defaultModel` and the worker's own `Slave.model` in the resolution chain.
  model         String?
  /// Roster-level provider override (M12 Task 6), mirroring `model`'s position in the chain.
  /// Nullable: this task only adds the column, Task 7/8 write and resolve it.
  provider      ProviderKind?
  /// Roster-level override of the template persona (M37 §2): sits between
  /// `SlaveTemplate.profile` and the worker's own `Slave.profile` in the resolution chain.
  profile       String?

  companyTeam CompanyTeam   @relation(fields: [companyTeamId], references: [id], onDelete: Cascade)
  /// Deliberately NOT cascading: a template CAN be deleted now (M27 §5), and this relation carries
  /// no `onDelete` rule for it, so `deleteSlaveTemplate` must delete every `CompanySlave` of the
  /// template explicitly, in the same transaction, before deleting the template row itself.
  template    SlaveTemplate @relation(fields: [templateId], references: [id])
  workers     Slave[]

  @@unique([companyTeamId, name])
}

enum PermissionMode {
  allow
  deny
}

enum ProviderKind {
  claude_code
  cursor
}

model SlavePermission {
  id      String         @id @default(uuid())
  slaveId String
  tool    String
  mode    PermissionMode

  slave Slave @relation(fields: [slaveId], references: [id], onDelete: Cascade)

  @@unique([slaveId, tool])
}

model SkillProvider {
  id     String  @id @default(uuid())
  name   String  @unique
  skills Skill[]
}

model Skill {
  id           String    @id @default(uuid())
  providerId   String
  name         String
  description  String
  /// When a scan first failed to find this skill on disk (M14 Decision 6). The catalog NEVER
  /// deletes: a run that referenced a skill keeps a row to point at, so its history stays
  /// legible. Cleared the moment a later scan finds it again.
  missingSince DateTime?

  provider SkillProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slaves   SlaveSkill[]

  @@unique([providerId, name])
}

model SlaveSkill {
  slaveId String
  skillId String

  slave Slave @relation(fields: [slaveId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([slaveId, skillId])
}

model ProviderConfiguration {
  id          String       @id @default(uuid())
  workspaceId String
  kind        ProviderKind
  settings    Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
}

enum RunKind {
  implementation
  review
  planning
}

enum PauseReason {
  human
  guardrail
  emergency_stop
  /// M36 t2: this run stopped to wait for another slave's answer -- nobody asked it to pause and
  /// no guardrail tripped. The category is what keeps a waiting run out of the surfaces that
  /// present a pause as something an operator has to act on (`apps/web/src/server/overview.ts`'s
  /// "blocked · needs you" panel).
  waiting_for_answer
}

enum MessageCategory {
  instruction
  feedback
  context
  priority_change
  question_response
}

/// The worker-protocol role a `SlaveMessage` plays (M36 t1) -- orthogonal to `MessageCategory`,
/// which classifies a HUMAN instruction. `sendMessage` (packages/control/src/messaging.ts) always
/// sets one of these; a worker-authored message never carries a `MessageCategory`.
enum MessageKind {
  question
  answer
  information
  blocker
  handoff
}

model Task {
  id                  String     @id @default(uuid())
  workspaceId         String
  title               String
  description         String
  status              TaskStatus @default(backlog)
  priority            Int        @default(0)
  requiredRole        String?
  /// M47 R2/R3: the capabilities this work needs, in the taxonomy's vocabulary -- the PLANNING and
  /// STAFFING key. `requiredRole` above stays the DISPATCH key and is derived from this list when
  /// the planner did not name one, so the scheduler keeps exactly one matching rule.
  requiredCapabilities String[] @default([])
  /// M48 R1: the typed handoff -- a validated `HandoffContract`. NULL means hand-made or planned
  /// before this milestone, and is never backfilled: inventing a contract for work nobody wrote one
  /// for would be worse than the paragraph it replaces.
  handoff             Json?
  /// M48 R2: the runbook stage this task belongs to. A LABEL: `decide()` has never read it, and a
  /// stage is not a dependency -- `TaskDependency` still decides what may start.
  stage               String?
  assigneeId          String?
  activeRunId         String?    @unique
  attempt             Int        @default(0)
  maxAttempts         Int
  lastRejectionReason String?
  branch              String?
  /// M35 t2: when this task's work actually reached the base branch, distinct from `status: done`
  /// (which only means "reviewed"). `merge.ts`'s real-merge path (`workspace.autoMerge` true)
  /// stamps this the moment the merge commits; its `!autoMerge` path -- spec Decision 5, marking
  /// the task `done` with no merge, branch and worktree left for a human -- leaves this `null`,
  /// on purpose, exactly as it always has. `world.ts`'s dependency gate reads this alongside
  /// `status` so a dependent is never provisioned from `baseBranch` while its dependency's
  /// commits are still sitting on an unmerged branch; `confirmIntegration`
  /// (`packages/control/src/integration.ts`) is the only other writer, for the human-merge case.
  integratedAt        DateTime?
  createdBy           Actor      @default(human)
  /// M40 §1: the goal version the PLAN that produced this task derived from -- provenance, not a
  /// foreign key (a `GoalVersion` is never deleted while its workspace lives, and a task must
  /// survive a history a cascade could not reach anyway). NULL for a hand-made task: no plan
  /// derived it from a goal, so it can never be "stale" against one. Backfilled to 1 for every
  /// task whose workspace already had a goal -- the only version that could have produced it.
  goalVersion         Int?
  /// Who caused this task to be created (M23 F6), nullable: the planner runs with no user for
  /// tasks created before this column existed, and `createdBy: slave`/`system` tasks have no
  /// human to attribute either. `onDelete: SetNull` -- a task must survive the deletion of the
  /// account that once created it.
  createdByUserId     String?
  createdAt           DateTime   @default(now())
  enqueuedAt          DateTime?
  mergeClaimedAt      DateTime?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  runs          SlaveRun[]
  artifacts     Artifact[]
  messages      SlaveMessage[]
  approvals     Approval[]
  dependencies  TaskDependency[] @relation("dependent")
  dependents    TaskDependency[] @relation("dependedOn")
  /// M49 R1: what was learnt ON this task. SetNull on the other side -- knowledge outlives it.
  memories      Memory[]
  /// M50 R2: the temporary specialists brought in for THIS task. SetNull on the other side -- a
  /// worker outlives the task it was hired for.
  engagedWorkers Slave[] @relation("EngagementWorkers")

  @@index([workspaceId, status])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String

  task      Task @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("dependedOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
}

model SlaveRun {
  id                String        @id @default(uuid())
  /// Nullable as of M8b: a `planning` run (Task 6) has no `Task` row to attach to -- it works
  /// toward `Workspace.goal`, not a task. `slave -> team -> workspace` is then the only linkage a
  /// task-less run has to a workspace, which every run-scoping query in the codebase must join
  /// through instead of `Task` (see the audit landed alongside this column).
  taskId            String?
  slaveId           String
  kind              RunKind       @default(implementation)
  status            RunStatus     @default(starting)
  sessionId         String?
  toolCalls         Int           @default(0)
  pausedAtStep      Int?
  /// The pause's category (human / guardrail / emergency_stop). Contrast with
  /// Checkpoint.pauseReason, which is the operator-facing free text of *why* — the string that
  /// went into the hook's deny message. This field is the enum; that one never is.
  pauseReason       PauseReason?
  /// Resume intent (spec M5 §3.3): set by the web/control layer while the run stays `paused`;
  /// the daemon's tick claims paused→resuming and clears both in the same update. The run must
  /// never sit in `resuming` without a process — the orphan sweep would destroy it.
  resumeRequestedAt DateTime?
  queuedMessage     String?
  /// Stop intent (M5 gate-fix B): `requestStop` writes both columns in the same conditioned
  /// update that claims `status: stopping`, before it kills the child -- so a run's stream ending
  /// with no terminal result can tell an operator's stop (this record present) from the guardrail
  /// sweep's own `stopping` claim (sweep.ts, no intent record, must still conclude `failed` so it
  /// counts toward the circuit breaker's failure streak). `stopRequestedBy` is who asked, echoed
  /// into the eventual `run.stopped` reason whichever side concludes the run. Left set after the
  /// run concludes -- historical record of who asked, not live state to clear.
  stopRequestedBy   String?
  stopRequestedAt   DateTime?
  /// Nullable as of M12 Task 6, and its `@default(0)` is gone -- not just widened. A `0` used to
  /// mean "actually free"; now it would also mean "we never measured this," and this column must
  /// not let those two facts collide. Unknown cost is `null`; a future insert that forgets to
  /// pass one now gets `null` at the database level instead of a silently wrong `0`.
  costUsd           Float?
  /// `RunOutcome.tokens.input` / `.output` (M14 §4.2). Nullable, no default: `null` is UNMEASURED
  /// -- a Cursor run (keyed on the run's PROVIDER, the same rule `skillCalls` follows), or a
  /// degraded Claude `result` line that carried no `usage`. `0` would be a measured zero the
  /// Analytics page would average in.
  tokensIn          Int?
  tokensOut         Int?
  /// Which skills this run invoked, and how many times each: `{ "superpowers:writing-plans": 2 }`
  /// (M14 §4.1), from a tally the pump keeps of the `Skill` tool calls it already observes.
  ///
  /// Written ONCE per pump, when that pump's event STREAM ENDS -- however it ended: a terminal
  /// result, a bare stream end, an operator's kill, or a pause. Deliberately not on the row's
  /// terminal status writes (fix round 1): the tally is a fact of the stream, while the row's
  /// conclusion is a fact of whoever won the race to write it, and those are different events --
  /// `packages/control/src/stop.ts` concludes an operator-stopped run with no tally in hand, and
  /// normally wins. A resumed run is a SECOND pump on this row, and MERGES into what is here
  /// rather than replacing it, which is what makes a pause -> resume total add up.
  ///
  /// THREE states, and the difference between the last two is Decision 4 (keyed on the run's
  /// PROVIDER, never on what the stream happened to contain):
  ///   - `{ "<skill>": n }` -- a Claude run that invoked skills.
  ///   - `{}`              -- a Claude run that invoked none. A MEASUREMENT: we watched, and
  ///                          there were none.
  ///   - `null`            -- a Cursor run, or a run whose stream has not ended yet. UNKNOWN:
  ///                          that runtime cannot report skill use at all, and an empty object
  ///                          there would claim a measurement nobody made.
  skillCalls        Json?
  /// Which runtime produced this run (M12 Task 6). Nullable: this task only adds the column --
  /// Tasks 7/8 resolve and write it, so every run recorded before them reads back null.
  provider          ProviderKind?
  pid               Int?
  worktreePath      String?
  startedAt         DateTime      @default(now())
  terminalAt        DateTime?
  endedAt           DateTime?

  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  slave      Slave       @relation(fields: [slaveId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint?
  /// The recorded run-context row (M37 §2) -- exists before the child process starts (`buildRunContext`,
  /// Task 2); a run without one never spawned.
  context    RunContext?
  /// M49 R1: what was learnt FROM this run. SetNull on the other side.
  memories   Memory[]

  @@index([taskId])
  @@index([slaveId, status])
}

model Checkpoint {
  id                String        @id @default(uuid())
  runId             String        @unique
  sessionId         String
  worktreePath      String
  pauseFlagPath     String
  lastToolUseId     String?
  lastToolName      String?
  numTurns          Int           @default(0)
  /// Unlike Workspace.verifyCommands/setupCommands, an empty array here is a perfectly ordinary
  /// value (no denials yet, no dirty files yet) rather than a refusal — so these two stay on
  /// Prisma's conventional nullable-array DDL rather than getting the NOT NULL enforcement above.
  deniedToolUseIds  String[]
  headCommit        String
  dirtyFiles        String[]
  cumulativeCostUsd Float         @default(0)
  cumulativeTokens  Int           @default(0)
  /// Fix round 1: the spawn-critical fields `resume()` cannot rediscover on its own, mirroring
  /// `packages/providers`' `Checkpoint` interface (see that file's docstring for the ruling this
  /// implements — ADR 0001 §5 puts `worktreePath` here for the same reason). Deliberately no
  /// `@default` on any of the four: the orchestrator always writes them, and a default would let
  /// a silently-incomplete checkpoint through the exact gate this task exists to close.
  settingsPath      String
  hookPath          String
  gitAuthorName     String
  gitAuthorEmail    String
  /// Free text: the operator-supplied reason that went into the hook's deny message, not the
  /// SlaveRun.pauseReason category enum. Never assign a SlaveRun.pauseReason enum member's
  /// literal spelling here — that would read as this field being the same enum when it is not.
  pauseReason       String?
  requestedBy       String?
  ts                DateTime      @default(now())
  /// M10 §6: the model the run started with, written at start and replayed by `adapter.resume` --
  /// resume must continue with the SAME model, never whatever `setSlaveModel` set most recently.
  /// A mid-run model change therefore affects only the NEXT run. Consumed starting Task 5.
  model             String?
  /// The provider the run started with (M12 Task 6), beside `model` for the same reason. Nullable
  /// -- this task only adds the column, Task 7/8 write and resolve it.
  provider          ProviderKind?

  run SlaveRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// One builder, one record (M37 §1, §2): what a run's prompt was assembled from, written before
/// the child process starts -- `apps/orchestrator/src/runContext.ts` (Task 2)'s `buildRunContext`.
/// A run with no `RunContext` row never spawned. `sections` is the `Manifest` shape
/// (`@slave-of-ai/domain`'s `runContextManifestSchema` validates it at read, since a hand-edited
/// row must not crash a reader); `prompt` is the exact text the model saw, in full -- this is the
/// durable answer to "what was this worker told", the reason `SlaveRun.suppliedMessageIds` (M36
/// t3, dropped in the same migration this table is created in) existed only as a stopgap.
model RunContext {
  id        String   @id @default(uuid())
  runId     String   @unique
  prompt    String
  sections  Json
  createdAt DateTime @default(now())

  run SlaveRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// M49 R1: one piece of what this organisation knows, with the provenance that says where it came
/// from. NOTHING here is ever deleted -- `status: superseded` points at what replaced it and
/// `status: removed` keeps the reason, and both rows stay.
///
/// Exactly one of `companyId`/`workspaceId`/`slaveId` is set, and it is the one `scope` names.
/// Enforced by `memoryDraftSchema` and `recordMemory` rather than by a CHECK constraint (plan
/// decision D1): Prisma's PSL cannot express one, and this milestone's migration has to survive
/// `prisma migrate diff` reporting no difference.
///
/// `confidence` and `verifiedBy` are plain strings rather than enums (plan decision D6): the
/// vocabulary is closed in `packages/domain/src/memory/types.ts` and validated at read, and four
/// enums is what §2 names.
model Memory {
  id              String           @id @default(uuid())
  type            MemoryType
  scope           MemoryScope
  companyId       String?
  workspaceId     String?
  slaveId         String?
  title           String
  body            String
  status          MemoryStatus     @default(candidate)
  /// `sourced` | `interpretation` -- M39's own vocabulary, the only one this system has.
  confidence      String           @default("interpretation")
  sourceKind      MemorySourceKind
  /// An event seq, a decision id, a goal version, a run id -- a pointer a human follows, as TEXT.
  sourceRef       String?
  createdBy       Actor
  createdByUserId String?
  /// SetNull, not Cascade: what was learnt outlives the task it was learnt on.
  taskId          String?
  runId           String?
  goalVersion     Int?
  capabilities    String[]         @default([])
  verifiedAt      DateTime?
  /// `verification` | `review` | `human`.
  verifiedBy      String?
  supersededById  String?
  removedReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company      Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slave        Slave?         @relation(fields: [slaveId], references: [id], onDelete: Cascade)
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  run          SlaveRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  supersededBy Memory?        @relation("MemorySupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Memory[]       @relation("MemorySupersedes")
  /// The rows this memory SUMMARISES, when it is a condensation (R5).
  condensedFrom MemorySource[] @relation("CondensationOf")
  /// The summaries this memory is a source OF.
  condensedInto MemorySource[] @relation("SourceOf")

  /// The three retrieval reads, one index each -- `memoriesForRun` asks for all three scopes at
  /// once and the Supervisor's world asks the first for a count alone.
  @@index([workspaceId, status, type, createdAt])
  @@index([slaveId, status, type, createdAt])
  @@index([companyId, status, type, createdAt])
  @@index([taskId])
}

/// M49 R5: which memories one condensation summarises. A join and not an array column, so the
/// sources cannot outlive their rows and "what is this a summary of" is one query either way.
model MemorySource {
  memoryId       String
  sourceMemoryId String

  memory       Memory @relation("CondensationOf", fields: [memoryId], references: [id], onDelete: Cascade)
  sourceMemory Memory @relation("SourceOf", fields: [sourceMemoryId], references: [id], onDelete: Cascade)

  @@id([memoryId, sourceMemoryId])
  @@index([sourceMemoryId])
}

enum MemoryType {
  fact
  decision
  procedure
  lesson
  observation
  hypothesis
}

enum MemoryScope {
  company
  workspace
  worker
}

enum MemoryStatus {
  candidate
  verified
  superseded
  removed
}

enum MemorySourceKind {
  run_output
  verification
  review
  decision
  goal
  human
  condensation
}

/// M38 section 2: one Supervisor decision -- the situation it was made on, the catalogue the rules
/// offered, the index chosen, the action, and what became of it. The decision RECORD is the
/// Supervisor's only output: every effect on the world goes through an existing control verb
/// (spec section 1, "a decision is not work"), so this row plus its `supervisor.*` events are the
/// whole audit trail.
///
/// `situation`, `candidates` and `action` are `Json` because they are domain shapes, not relations
/// -- `situationSchema`, `candidateSchema` and `actionSchema` (`@slave-of-ai/domain`) validate them
/// at read, the same way `RunContext.sections` is validated. Storing the catalogue as it was
/// offered is what lets a human months later see the choice that was actually available, not the
/// one today's rules would build.
model SupervisorDecision {
  id               String                   @id @default(uuid())
  workspaceId      String
  situationKind    SupervisorSituationKind
  /// The second half of the situation key `(workspaceId, situationKind, subjectId)`: the task id,
  /// the message id, the role name, or the workspace id -- which one depends on the kind.
  subjectId        String
  /// The `Situation` snapshot the decision was made on.
  situation        Json
  /// The `Candidate[]` the rules offered, tiers included.
  candidates       Json
  chosenIndex      Int
  /// The chosen `Action` (kind + params).
  action           Json
  /// M39 §2: the `Draft` an `answer_question` decision was made on -- the answer text a second
  /// model call wrote, the citations that verified, the ones that did not, the critical signals,
  /// and (from an approval with an edit) what a human typed instead. Null for every other action:
  /// nothing else puts a model's words in front of a worker. Validated at read by `draftSchema`
  /// (`@slave-of-ai/domain`), the way `action` is validated by `actionSchema` beside it.
  draft            Json?
  rationale        String
  tier             SupervisorTier
  status           SupervisorDecisionStatus
  decidedBy        SupervisorDecider
  /// What the decision call cost. null is UNMEASURED, the same rule as `SlaveRun.costUsd` -- an
  /// unmeasured call is charged at `SUPERVISOR_PER_CALL_CAP_USD` when spend is summed, never at 0.
  /// Always null when `modelCalled` is false, which is a decision that made no call at all.
  modelCostUsd     Float?
  /// Whether a model call was actually MADE for this decision (spec erratum E6).
  ///
  /// Not derivable from `decidedBy`: a call that came back unusable -- failed, an isolation breach,
  /// or an answer that would not parse -- falls back to the rules, so the row honestly says
  /// `decidedBy: rules` while the money was still spent. Without this column such a call with a
  /// null cost was indistinguishable from a decision that never called anybody, and so was never
  /// charged. Unmeasured, in `workspaceSpend`, is `modelCalled && modelCostUsd == null`.
  modelCalled      Boolean                  @default(false)
  /// The `refusalText` of the verb that refused an applied action (status `failed`).
  failureReason    String?
  createdAt        DateTime                 @default(now())
  /// `pending` only: `createdAt + PENDING_TTL_MS`, after which `expirePendingDecisions` retires it.
  expiresAt        DateTime?
  /// When a `pending` decision left that state. Null for one still open AND for the `applied` and
  /// `failed` rows that were never pending -- `filterFresh` cools those from `createdAt` instead.
  resolvedAt       DateTime?
  resolvedByUserId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The web panel's and the CLI's "recent decisions for this project", newest first.
  @@index([workspaceId, createdAt])
  /// The situation key: what `recordDecision` checks for an open decision or a live cooldown, and
  /// what the world loader reads the recent-decisions window from.
  @@index([workspaceId, situationKind, subjectId, createdAt])
}

/// The closed set of stuck situations the rules can see (`SITUATION_KINDS` in
/// `packages/domain/src/supervisor/situations.ts`).
enum SupervisorSituationKind {
  no_reviewer
  no_planner
  /// M48 R5: a goal exists, the board is empty and no way of working has been chosen. The subject
  /// is the WORKSPACE, not a row in it.
  runbook_recommended
  review_cap_blocked
  task_failed
  task_blocked_human
  /// M40 §3. The one kind `observe` never produces: it is the manager's own judgement from a
  /// re-plan run's delta, recorded by `concludeReplan`, not a predicate over rows.
  stale_task
  waiting_stale
  unanswerable_question
  ready_unstaffed
  /// M47 R4: a startable task needs a capability nobody can be dispatched for. Supersedes
  /// `ready_unstaffed` for the task that raised it (plan erratum E8); `ready_unstaffed` remains
  /// the role-only fallback for a task that declared no capabilities.
  capability_unstaffed
  done_not_integrated_stale
  /// M50 R3: a worker brought in for one assignment, whose assignment is over. The subject is the
  /// SLAVE.
  engagement_over
  /// M49 R2: unverified observation candidates are piling up on this project.
  memory_candidates_piling
  workspace_halted
}

/// What happens to a chosen action -- fixed in code by `tierOf`, never chosen by the model.
enum SupervisorTier {
  applied
  proposed
  escalated
  noop
}

/// The life of a decision row. `pending` is the only OPEN state.
enum SupervisorDecisionStatus {
  applied
  pending
  approved
  rejected
  expired
  failed
}

/// Who picked the candidate: the model, or `chooseByRules`.
enum SupervisorDecider {
  model
  rules
}

model Artifact {
  id        String   @id @default(uuid())
  taskId    String
  kind      String
  path      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// A durable, scoped message (M36 t1). Extended rather than duplicated into a parallel
/// worker-to-worker table -- see this task's migration for why a human-sent instruction and a
/// worker-sent question share one table. `slaveId` was already this row's one `Slave` reference;
/// it is now documented as the SENDER, which every row (human or worker) always has.
model SlaveMessage {
  id               String           @id @default(uuid())
  taskId           String?
  /// SENDER. `sendMessage` resolves this from the sending run's own `SlaveRun.slaveId` -- never
  /// from caller input, so a model that names someone else as sender is ignored.
  slaveId          String
  /// Scope boundary (M36 t1): the workspace the sending run belongs to, denormalized from
  /// `slave -> team -> workspaceId` (the same two-hop derivation `pause.ts`/`dependency.ts`
  /// already make) so every scoping read is a single indexed column, not a join. Every read and
  /// write `sendMessage`/`listMessagesForSlave`/`markMessageRead` perform is confined to it; a
  /// recipient outside it is refused before anything is written.
  workspaceId      String
  /// The run that sent this, when the sender is a worker (M36 t1) -- kept for provenance. No
  /// Prisma relation on purpose: `slaveId` above already cascades this row when the sender is
  /// deleted, and a second FK to `SlaveRun` with its own `ON DELETE` would fight that cascade
  /// over the same row the moment a slave is deleted (Postgres's "tuple already modified by an
  /// operation triggered by the current command" diamond). Null for a human-authored message,
  /// which has no run.
  senderRunId      String?
  /// Exactly one of these two identifies who a message is addressed to (M36 t1): a named worker,
  /// or every worker currently holding a role. `sendMessage` refuses both-or-neither before
  /// writing anything -- the database does not enforce it. No relation on `recipientSlaveId`
  /// either, for the same reason as `senderRunId`: deleting a slave must not reach back and
  /// delete (or null) messages addressed TO it, only ones it sent.
  recipientSlaveId String?
  recipientRole    String?
  /// Groups a message with its replies (M36 t1). Defaults to the opening message's own id;
  /// generated application-side (not `@default(uuid())`) so the same value can be written into
  /// both this column and `id` on that first row in one insert.
  threadId         String
  /// The message this one replies to (M36 t1), or null for a thread's opener. `sendMessage`
  /// derives `threadId` from this row's own `threadId` when it is set, rather than trusting a
  /// caller-supplied `threadId` that could disagree with it.
  replyToId        String?
  category         MessageCategory?
  /// The worker-protocol role this message plays (M36 t1) -- required for every row `sendMessage`
  /// writes; see the enum's own doc comment for how it relates to `category`.
  kind             MessageKind
  body             String
  actor            Actor            @default(human)
  /// Whether the sender expects a reply (M36 t1) -- true for a worker's `question`; left false
  /// for `information`/`handoff`.
  expectsReply     Boolean          @default(false)
  /// `sendMessage`'s idempotency key, namespaced by verb the way `SimulationJournalEntry`'s is
  /// (`packages/control/src/simulation/shared.ts`'s `namespacedKey`) -- Task 3's `answer` verb
  /// will write into this same column, and the namespace is what keeps the two verbs' keys from
  /// colliding on a coincidentally-equal string.
  idempotencyKey   String?
  /// Read state (M36 t1). Delivery state is `deliveredAt` below.
  readAt           DateTime?
  /// Delivery state (M36 t3), and only ever set on an `answer`: the moment `deliverAnswers`
  /// (apps/orchestrator/src/deliver.ts) claimed this answer as the one that would wake the run
  /// that asked. It is a CLAIM, not a log line -- the claim is a conditioned `updateMany` on
  /// `deliveredAt IS NULL`, so two deliveries racing over the same answer row produce one resume
  /// intent between them, and a replay of the same answer produces none at all. Cleared again if
  /// the resume it was claimed for is refused, so a transient refusal is not a permanently
  /// swallowed answer. Null on every question, every human instruction, and every answer not yet
  /// delivered -- and, since fix round 1, null is PENDING only: an answer that lost the race is
  /// `supersededAt`, not null.
  deliveredAt      DateTime?
  /// The moment `deliverAnswers` established that this answer will never wake anybody (M36 t3 fix
  /// round 1): another answer to the same question had already been delivered by the time this one
  /// was looked at. A role-addressed question is injected into every holder of the role, so two
  /// workers concluding in the same window each write a real answer and only the first can close
  /// the wait -- without this column the second is indistinguishable from one still waiting to be
  /// delivered, on a question that has already dropped out of `listPendingQuestions`. Stamping it
  /// (and logging it, see `deliver.ts`) is what keeps §13's "no failure is silent" true here.
  /// Mutually exclusive with `deliveredAt` by construction: one is set, or the other, or neither.
  supersededAt     DateTime?
  /// Monotonic, gap-permitted insertion order -- `createdAt`'s millisecond resolution is not fine
  /// enough to order two messages written in the same tick, the same reasoning
  /// `ExecutionEvent.seq` (packages/events/src/append.ts) already codifies for this codebase.
  /// `listMessagesForSlave` reads a thread back in this order, not `createdAt`'s.
  seq              BigInt           @unique @default(autoincrement())
  createdAt        DateTime         @default(now())

  task    Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  slave   Slave          @relation(fields: [slaveId], references: [id], onDelete: Cascade)
  replyTo SlaveMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies SlaveMessage[] @relation("MessageReplies")

  @@unique([workspaceId, idempotencyKey])
  @@index([slaveId, createdAt])
  /// M36 t3: `deliverAnswers` reads "the answers to this question" on every tick that has a
  /// waiting run, and t1 indexed the recipient, thread and idempotency shapes rather than this one.
  @@index([replyToId])
  @@index([workspaceId, recipientSlaveId, readAt])
  @@index([workspaceId, recipientRole, readAt])
  @@index([threadId, seq])
  /// M36 final review: "the messages this run sent, latest first" is the shape three readers
  /// share -- `deliver.ts` matching a waiting run to the question it asked, and the two web
  /// surfaces (`overview.ts`, `tasks.ts`) rendering `waiting for <whoever was asked>`. All three
  /// order by `seq` inside a `senderRunId` filter, and none of the indexes above starts with
  /// `senderRunId`.
  @@index([senderRunId, seq])
}

model Approval {
  id        String   @id @default(uuid())
  taskId    String
  approved  Boolean
  reason    String?
  decidedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum EventType {
  task_created                @map("task.created")
  task_started                @map("task.started")
  task_done                   @map("task.done")
  task_rework                 @map("task.rework")
  run_started                 @map("run.started")
  run_tool_call               @map("run.tool_call")
  run_paused                  @map("run.paused")
  run_resumed                 @map("run.resumed")
  run_resume_requested        @map("run.resume_requested")
  slave_message_sent          @map("slave.message_sent")
  /// M39 t2: `reassignQuestion` put an unanswered question in front of a different worker -- the
  /// question row itself moved (`recipientSlaveId` set, `recipientRole` cleared), so no new
  /// message was sent and `slave.message_sent` would be a lie about what happened.
  slave_message_reassigned    @map("slave.message_reassigned")
  /// M37 t3: `setProfile` wrote a slave's persona (slave targets only -- a template and a catalog
  /// slave have no workspace to log into); `setRuntimeRoles` changed the set the scheduler,
  /// review/planning staffing and message role-addressing all dispatch on.
  slave_profile_changed       @map("slave.profile_changed")
  slave_runtime_roles_changed @map("slave.runtime_roles_changed")
  guardrail_tripped           @map("guardrail.tripped")
  task_verifying              @map("task.verifying")
  task_verify_passed          @map("task.verify_passed")
  task_verify_failed          @map("task.verify_failed")
  task_failed                 @map("task.failed")
  run_output                  @map("run.output")
  run_pause_requested         @map("run.pause_requested")
  run_stopped                 @map("run.stopped")
  run_succeeded               @map("run.succeeded")
  run_failed                  @map("run.failed")
  run_tool_denied             @map("run.tool_denied")
  task_dependency_added       @map("task.dependency_added")
  task_dependency_removed     @map("task.dependency_removed")
  task_review_started         @map("task.review_started")
  task_review_approved        @map("task.review_approved")
  task_review_rejected        @map("task.review_rejected")
  task_merge_failed           @map("task.merge_failed")
  workspace_goal_set          @map("workspace.goal_set")
  workspace_plan_created      @map("workspace.plan_created")
  /// M40 §2: the goal moved on a board that already had tasks, so the tick started a DELTA re-plan
  /// run (`workspace.replan_started`, whose `version` is the dedup key for "one re-plan per goal
  /// version"), and that run concluded (`workspace.replanned`, which names what was added, what
  /// was proposed for cancellation and what cancellation the status rule refused).
  workspace_replan_started    @map("workspace.replan_started")
  workspace_replanned         @map("workspace.replanned")
  /// M40 §4: `cancelTask` took a `backlog`/`ready`/`blocked` task off the board -- an operator's
  /// own call, or an approved `stale_task` proposal from a re-plan.
  task_cancelled              @map("task.cancelled")
  workspace_company_assigned  @map("workspace.company_assigned")
  workspace_settings_changed  @map("workspace.settings_changed")
  /// M23 A1: the first event a workspace ever logs, from `createWorkspace`.
  workspace_created           @map("workspace.created")
  /// M27 §3: the project was archived / restored; the archive payload carries the footprint.
  workspace_archived          @map("workspace.archived")
  workspace_restored          @map("workspace.restored")
  /// M23 B2: `collectTaskWorktree` removed a terminal task's worktree -- aged out or by an
  /// operator's button.
  task_worktree_collected     @map("task.worktree_collected")
  /// M23 D1: an operator edited the roster -- `org.ts`'s five control verbs (rename/re-role/
  /// delete a slave, rename/delete a team) all emit this one type, distinguished by the
  /// payload's `field`.
  org_changed                 @map("org.changed")
  /// M35 t2: `confirmIntegration` stamped `Task.integratedAt` by hand -- the `!autoMerge` task
  /// was already `done`; this is the human saying its branch has now actually reached the base
  /// branch, unblocking whatever depends on it.
  task_integrated             @map("task.integrated")
  /// M35 t5: `unblockTask` moved a `blocked` task back to `rework` -- an operator's exit from
  /// one of the four places that park a task `blocked` with nothing to move it out.
  task_unblocked              @map("task.unblocked")
  /// M38 section 2: the Supervisor's own five events. `supervisor.decided` is written for every
  /// decision; `supervisor.proposed` alongside it when the tier made the decision a `pending`
  /// proposal; `supervisor.applied` when the action reached the world through a control verb;
  /// `supervisor.resolved` when a pending decision was approved, rejected or expired; and
  /// `supervisor.failed` when the verb behind an applied decision refused it. Appended with
  /// `actor: system` except the `supervisor.resolved` of an approve or a reject, which is
  /// `actor: human` because a person resolved it -- the `Actor` enum has no `supervisor` member
  /// (spec erratum E4), so the Supervisor itself is always `system`.
  supervisor_decided          @map("supervisor.decided")
  supervisor_proposed         @map("supervisor.proposed")
  supervisor_applied          @map("supervisor.applied")
  supervisor_resolved         @map("supervisor.resolved")
  supervisor_failed           @map("supervisor.failed")
  /// M48 R5: a runbook was adopted for this workspace, or the adopted one was cleared. The
  /// payload names the runbook either way.
  workspace_runbook_adopted   @map("workspace.runbook_adopted")
  /// M49 R4: a memory was written (`memory.recorded`, whose payload says what kind and whether it
  /// is knowledge or still a claim) or changed state (`memory.changed` -- verified, superseded or
  /// removed). Nothing is ever deleted, so these two are the whole life of a memory.
  memory_recorded             @map("memory.recorded")
  memory_changed              @map("memory.changed")
  /// M50 R3: an ephemeral worker's engagement ended -- runtime roles emptied, worktrees collected,
  /// and everything it produced left where it is. Never a deletion: `org.changed { field:
  /// 'deleted' }` is that, and this is not it.
  slave_released              @map("slave.released")
}

model ExecutionEvent {
  seq         BigInt    @id @default(autoincrement())
  ts          DateTime  @default(now())
  type        EventType
  workspaceId String
  taskId      String?
  slaveId     String?
  runId       String?
  actor       Actor
  payload     Json
  /// Who caused this event (M23 F6), nullable: the CLI and the orchestrator write events with no
  /// user, so this rides on every append but is unset unless a web request supplied a
  /// `Principal`. `onDelete: SetNull` -- the event log must survive the deletion of the account
  /// that once produced an entry in it.
  userId      String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, seq])
  @@index([workspaceId, slaveId, seq])
  @@index([workspaceId, taskId, seq])
  @@index([runId, seq])
  @@index([userId])
}

/// M23 F2: a local account -- username + PBKDF2 password hash, nothing else. The event and task
/// columns that attribute activity to one of these rows (m23_event_user, M23 F6) point back here
/// via the relations below.
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  executionEvents   ExecutionEvent[]
  createdTasks      Task[]
  goalSetWorkspaces Workspace[]
  simulations       SimulationRun[]
}

/// M29: a company simulation run (spec §3). Bound to the CATALOG company, never to a workspace:
/// the software flow is Git and stays so. `definition` is frozen at creation (roster snapshot,
/// roles, policy, scenario); `state` is the engine's current world; `version` is the optimistic
/// lock every step takes. Simulated money lives inside `state` as integer minor units -- never in
/// a column that could be mistaken for real spend.
enum SimulationSector {
  trade
  software
}

enum SimulationMode {
  simulation
}

enum DecisionProviderKind {
  rules
  llm
}

enum SimulationStatus {
  ready
  running
  paused
  finished
  halted
}

enum SimulationJournalKind {
  decision
  action_applied
  action_rejected
  event
  external_event
  control
}

model SimulationRun {
  id               String               @id @default(uuid())
  companyId        String
  name             String
  sector           SimulationSector
  mode             SimulationMode       @default(simulation)
  decisionProvider DecisionProviderKind @default(rules)
  /// M31a: an `llm` run's model choice and cost cap (spec §3). Null on a `rules` run -- these
  /// three fields only mean something together, and only when `decisionProvider` is `llm`.
  modelProvider    ProviderKind?
  model            String?
  maxModelCostUsd  Float?
  seed             Int
  definition       Json
  state            Json
  version          Int                  @default(0)
  status           SimulationStatus     @default(ready)
  simTime          Int                  @default(0)
  stepCount        Int                  @default(0)
  /// M29 named this `decisionCount`; it counts actions, not decision points (M29 final review).
  /// The column keeps its name, the field says what it holds.
  actionCount      Int                  @default(0) @map("decisionCount")
  /// M30 auto-run intent (spec §3): step one day every `autoRunEveryMs` while running, until
  /// `simTime >= autoRunUntilDay`; `lastAutoStepAt` is the pacing watermark the daemon's verb
  /// compares under the row lock. All three null = no intent.
  autoRunEveryMs   Int?
  autoRunUntilDay  Int?
  lastAutoStepAt   DateTime?
  haltedReason     String?
  clonedFromId     String?
  createdByUserId  String?
  createdAt        DateTime             @default(now())

  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clonedFrom        SimulationRun?           @relation("SimulationClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones            SimulationRun[]          @relation("SimulationClone")
  createdBy         User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  journal           SimulationJournalEntry[]
  modelUsage        SimulationModelUsage[]
  /// M33: the workspaces whose organisation was adopted from this run (design §2). A run may be
  /// adopted by many; a workspace records at most one origin.
  adoptedWorkspaces Workspace[]              @relation("SimulationAdoption")

  @@unique([companyId, name])
  @@index([companyId])
}

/// The run's own ordered record: decisions, applied/rejected actions, rule events, injected
/// events, control operations. `seq` is per run; `idempotencyKey` makes a repeated control
/// request return its first outcome instead of stepping twice.
model SimulationJournalEntry {
  id             String                @id @default(uuid())
  simulationId   String
  seq            Int
  simTime        Int
  kind           SimulationJournalKind
  actorRole      String?
  payload        Json
  idempotencyKey String?
  createdAt      DateTime              @default(now())

  simulation SimulationRun @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, seq])
  @@unique([simulationId, idempotencyKey])
  @@index([simulationId, simTime])
}

/// Real model spend attributable to a simulation (M31 writes it; M29 writes nothing). `costUsd`
/// null is UNMEASURED, the same rule as `SlaveRun.costUsd` -- never 0 for an unknown figure.
model SimulationModelUsage {
  id           String       @id @default(uuid())
  simulationId String
  seq          Int
  provider     ProviderKind
  costUsd      Float?
  tokensIn     Int?
  tokensOut    Int?
  /// M31a: the simulated day and role the decision call was made for -- both null on a row
  /// written before M31a, or by a caller that has no role to attribute (additive, optional).
  simTime      Int?
  role         String?
  createdAt    DateTime     @default(now())

  simulation SimulationRun @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, seq])
  @@index([simulationId])
}

/// M42 §R5: one run of `import-catalog`, and the whole of its auditable record.
///
/// NOT an `ExecutionEvent`: that table's `workspaceId` is NOT NULL and every reader of the log is
/// workspace-scoped, while the template catalog belongs to no project at all -- the same gap
/// `setProfile`'s doc comment names for a template-level profile write. So the import writes a row
/// of its own instead of inventing a workspace for an event, and `list-imports` and the web read
/// this table.
///
/// `report` is the full per-row `ImportReport` (`packages/control/src/catalog.ts`) as JSONB: the
/// counters beside it are the summary an operator scans, and the report is what they open when one
/// of the counters is not what they expected. A dry run writes NO row (it changed nothing).
model CatalogImport {
  id         String   @id @default(uuid())
  /// The catalog's name, which is the first segment of every `sourceId` this run wrote.
  catalog    String
  /// The absolute directory it was read from, on the daemon host's disk.
  directory  String
  /// WHO ran it, by NAME (`--by`), not a `Principal`: the CLI is this verb's only caller and has no
  /// session -- `setProfile(target, profile, actor)`'s idiom.
  by         String?
  startedAt  DateTime
  finishedAt DateTime
  created    Int
  updated    Int
  unchanged  Int
  skipped    Int
  report     Json

  @@index([startedAt])
}

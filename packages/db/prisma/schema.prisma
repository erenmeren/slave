generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  backlog
  ready
  blocked
  assigned
  running
  verifying
  reviewing
  merging
  rework
  done
  failed
  cancelled
}

enum RunStatus {
  starting
  working
  pause_requested
  paused
  resuming
  stopping
  stopped
  succeeded
  failed
}

enum Actor {
  human
  agent
  system
}

/// verifyCommands/setupCommands are NOT NULL at the database level, a deliberate departure from
/// Prisma's own DDL convention for a required String[] with no @default (which is a plain
/// nullable column). An empty verifyCommands is not a neutral default here — it is a refusal to
/// ever let a task on this workspace verify as complete, so a caller that forgets the field must
/// fail loudly at creation rather than silently getting `[]`. See the m3_runs_checkpoints_commands
/// migration for the DDL that enforces this.
model Workspace {
  id             String    @id @default(uuid())
  /// Unique as of M23 A1: a workspace is addressed by name from the CLI and the Settings form,
  /// so two rows sharing a name would make that addressing permanently ambiguous.
  name           String    @unique
  repoPath       String
  baseBranch     String    @default("main")
  verifyCommands String[]
  setupCommands  String[]
  autoMerge      Boolean   @default(false)
  haltedReason   String?
  haltedAt       DateTime?
  /// The operator's standing instruction for what this workspace's agents are working toward
  /// (M8b). Read by the planner (Task 4) and written by the workspace settings UI (Task 6) --
  /// unlike `verifyCommands`/`setupCommands` above, an unset goal is a perfectly ordinary state
  /// (no planning run has run yet), so this stays on Prisma's conventional nullable-String DDL.
  goal           String?
  /// The company assigned to run this project (M10 §5), nullable: the engine never required a
  /// company, and existing seeded workspaces keep their hand-made teams/agents untouched
  /// (Decision 7). Assignment is one-way in M10 -- no un-assignment or re-assignment to a
  /// different company (Decision 2) -- so this column only ever moves from null to set.
  companyId      String?

  maxConcurrentRuns       Int   @default(3)
  /// The spend ceiling this workspace's budget guardrail enforces (spec §9.2). Nullable as of
  /// M12 Task 9, and the `@default(20)` deliberately STAYS: a workspace is budgeted unless an
  /// operator deliberately clears it, so no existing row moves and every new one is guarded
  /// exactly as it is today. `null` means "this workspace is not budgeted", which spec §6 makes
  /// the ONLY state in which a cost-blind runtime (`ProviderCapabilities.reportsCost === false`)
  /// may run: the guardrail is real or it is absent, never silently inert. Dropping the default
  /// instead would leave every newly created workspace unguarded -- strictly worse than the bug
  /// this column's nullability exists to fix.
  budgetUsd               Float? @default(20)
  runTimeoutMs            Int   @default(1800000)
  maxToolCallsPerRun      Int   @default(200)
  maxAttempts             Int   @default(3)
  consecutiveFailureLimit Int   @default(3)

  createdAt DateTime @default(now())

  // No explicit onDelete: company deletion is out of scope for M10 (the design spec never
  // addresses it), so this optional relation keeps Prisma's Postgres default for an optional
  // FK -- SetNull -- rather than a Cascade that would destroy a project's history.
  company Company? @relation(fields: [companyId], references: [id])

  teams                  Team[]
  providerConfigurations ProviderConfiguration[]
  tasks                  Task[]
}

model Team {
  id            String  @id @default(uuid())
  workspaceId   String
  name          String
  /// The roster link (M11): null for legacy hand-made teams created before the organization
  /// model, or for a team whose roster row has since been deleted. `assignCompany` matches
  /// project teams by this id first, adopting (stamping) a legacy same-named team on first
  /// assign rather than duplicating it. `onDelete: SetNull` (not Cascade), mirroring
  /// `Agent.companyAgentId`: a team with run history must survive its roster row's deletion.
  companyTeamId String?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyTeam CompanyTeam? @relation(fields: [companyTeamId], references: [id], onDelete: SetNull)
  agents      Agent[]

  @@index([workspaceId])
}

model Agent {
  id             String  @id @default(uuid())
  teamId         String
  name           String
  role           String
  requiredRole   String?
  /// The roster link (M10): null for legacy hand-made agents created before the organization
  /// model, or for a worker whose roster row has since been deleted. `onDelete: SetNull` (not
  /// Cascade) on the relation below is a binding ruling, not an oversight -- a worker with run
  /// history must survive its roster row's deletion; deleting a company must never cascade into
  /// deleting the runs it produced.
  companyAgentId String?
  /// The worker-level model override (M10 §6): first non-null wins in
  /// `worker.model ?? companyAgent.model ?? template.defaultModel ?? null`. Legacy agents with no
  /// roster link resolve through this column alone.
  model          String?
  /// The worker-level provider override (M12 Task 6), mirroring `model`'s resolution chain.
  /// Nullable: this task only adds the column -- Task 7/8 write and resolve it, and every
  /// existing row reads back null until then.
  provider       ProviderKind?

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  companyAgent CompanyAgent? @relation(fields: [companyAgentId], references: [id], onDelete: SetNull)

  permissions AgentPermission[]
  skills      AgentSkill[]
  runs        AgentRun[]
  messages    AgentMessage[]

  @@index([teamId])
}

/// The global catalog (M10 §3): role-shaped cookie cutters a company's roster is instantiated
/// from. `role` is the SAME exact-match string the scheduler, review pass and planning pass
/// already key on -- a template whose role is `reviewer` produces workers the review pass can
/// staff. No new role machinery. Template deletion is out of scope in M10 (Decision 9,
/// referential simplicity); templates are append-only.
model AgentTemplate {
  id            String         @id @default(uuid())
  name          String         @unique
  role          String
  description   String         @default("")
  defaultModel  String?
  /// The catalog-level provider default (M12 Task 6), sitting at the far end of the same
  /// resolution chain `defaultModel` anchors -- named `provider`, not `defaultProvider`, to match
  /// this task's migration SQL, which stamps every table's new column with the same name. Task
  /// 7/8 write and resolve it; every existing row reads back null until then.
  provider      ProviderKind?
  createdAt     DateTime       @default(now())
  companyAgents CompanyAgent[]
}

/// A persistent roster (M10 §4) -- the durable identity ("Atlas") statistics accrue to, distinct
/// from the project-local `Agent` workers that get materialized from it. One company can serve
/// many projects (M10 Decision 2).
model Company {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  teams     CompanyTeam[]

  workspaces Workspace[]
}

model CompanyTeam {
  id        String @id @default(uuid())
  companyId String
  name      String

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agents       CompanyAgent[]
  /// The project `Team` rows materialized/adopted from this roster team across every workspace
  /// it has been assigned to (M11).
  projectTeams Team[]

  @@unique([companyId, name])
}

model CompanyAgent {
  id            String  @id @default(uuid())
  companyTeamId String
  templateId    String
  /// The durable identity -- "Atlas" -- statistics and history accrue to this name across every
  /// project the company is assigned to, even though each project gets its own materialized
  /// worker `Agent` row.
  name          String
  /// Roster-level override of the template default (M10 §6): sits between
  /// `AgentTemplate.defaultModel` and the worker's own `Agent.model` in the resolution chain.
  model         String?
  /// Roster-level provider override (M12 Task 6), mirroring `model`'s position in the chain.
  /// Nullable: this task only adds the column, Task 7/8 write and resolve it.
  provider      ProviderKind?

  companyTeam CompanyTeam   @relation(fields: [companyTeamId], references: [id], onDelete: Cascade)
  /// Deliberately NOT cascading: templates are append-only (Decision 9), so a roster member never
  /// loses its template out from under it via deletion -- there is nothing to delete.
  template    AgentTemplate @relation(fields: [templateId], references: [id])
  workers     Agent[]

  @@unique([companyTeamId, name])
}

enum PermissionMode {
  allow
  deny
}

enum ProviderKind {
  claude_code
  cursor
}

model AgentPermission {
  id      String         @id @default(uuid())
  agentId String
  tool    String
  mode    PermissionMode

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, tool])
}

model SkillProvider {
  id     String  @id @default(uuid())
  name   String  @unique
  skills Skill[]
}

model Skill {
  id           String    @id @default(uuid())
  providerId   String
  name         String
  description  String
  /// When a scan first failed to find this skill on disk (M14 Decision 6). The catalog NEVER
  /// deletes: a run that referenced a skill keeps a row to point at, so its history stays
  /// legible. Cleared the moment a later scan finds it again.
  missingSince DateTime?

  provider SkillProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  agents   AgentSkill[]

  @@unique([providerId, name])
}

model AgentSkill {
  agentId String
  skillId String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model ProviderConfiguration {
  id          String       @id @default(uuid())
  workspaceId String
  kind        ProviderKind
  settings    Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
}

enum RunKind {
  implementation
  review
  planning
}

enum PauseReason {
  human
  guardrail
  emergency_stop
}

enum MessageCategory {
  instruction
  feedback
  context
  priority_change
  question_response
}

model Task {
  id                  String     @id @default(uuid())
  workspaceId         String
  title               String
  description         String
  status              TaskStatus @default(backlog)
  priority            Int        @default(0)
  requiredRole        String?
  assigneeId          String?
  activeRunId         String?    @unique
  attempt             Int        @default(0)
  maxAttempts         Int
  lastRejectionReason String?
  branch              String?
  createdBy           Actor      @default(human)
  createdAt           DateTime   @default(now())
  enqueuedAt          DateTime?
  mergeClaimedAt      DateTime?

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs         AgentRun[]
  artifacts    Artifact[]
  messages     AgentMessage[]
  approvals    Approval[]
  dependencies TaskDependency[] @relation("dependent")
  dependents   TaskDependency[] @relation("dependedOn")

  @@index([workspaceId, status])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String

  task      Task @relation("dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("dependedOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
}

model AgentRun {
  id                String       @id @default(uuid())
  /// Nullable as of M8b: a `planning` run (Task 6) has no `Task` row to attach to -- it works
  /// toward `Workspace.goal`, not a task. `agent -> team -> workspace` is then the only linkage a
  /// task-less run has to a workspace, which every run-scoping query in the codebase must join
  /// through instead of `Task` (see the audit landed alongside this column).
  taskId            String?
  agentId           String
  kind              RunKind      @default(implementation)
  status            RunStatus    @default(starting)
  sessionId         String?
  toolCalls         Int          @default(0)
  pausedAtStep      Int?
  /// The pause's category (human / guardrail / emergency_stop). Contrast with
  /// Checkpoint.pauseReason, which is the operator-facing free text of *why* — the string that
  /// went into the hook's deny message. This field is the enum; that one never is.
  pauseReason       PauseReason?
  /// Resume intent (spec M5 §3.3): set by the web/control layer while the run stays `paused`;
  /// the daemon's tick claims paused→resuming and clears both in the same update. The run must
  /// never sit in `resuming` without a process — the orphan sweep would destroy it.
  resumeRequestedAt DateTime?
  queuedMessage     String?
  /// Stop intent (M5 gate-fix B): `requestStop` writes both columns in the same conditioned
  /// update that claims `status: stopping`, before it kills the child -- so a run's stream ending
  /// with no terminal result can tell an operator's stop (this record present) from the guardrail
  /// sweep's own `stopping` claim (sweep.ts, no intent record, must still conclude `failed` so it
  /// counts toward the circuit breaker's failure streak). `stopRequestedBy` is who asked, echoed
  /// into the eventual `run.stopped` reason whichever side concludes the run. Left set after the
  /// run concludes -- historical record of who asked, not live state to clear.
  stopRequestedBy   String?
  stopRequestedAt   DateTime?
  /// Nullable as of M12 Task 6, and its `@default(0)` is gone -- not just widened. A `0` used to
  /// mean "actually free"; now it would also mean "we never measured this," and this column must
  /// not let those two facts collide. Unknown cost is `null`; a future insert that forgets to
  /// pass one now gets `null` at the database level instead of a silently wrong `0`.
  costUsd           Float?
  /// `RunOutcome.tokens.input` / `.output` (M14 §4.2). Nullable, no default: `null` is UNMEASURED
  /// -- a Cursor run (keyed on the run's PROVIDER, the same rule `skillCalls` follows), or a
  /// degraded Claude `result` line that carried no `usage`. `0` would be a measured zero the
  /// Analytics page would average in.
  tokensIn          Int?
  tokensOut         Int?
  /// Which skills this run invoked, and how many times each: `{ "superpowers:writing-plans": 2 }`
  /// (M14 §4.1), from a tally the pump keeps of the `Skill` tool calls it already observes.
  ///
  /// Written ONCE per pump, when that pump's event STREAM ENDS -- however it ended: a terminal
  /// result, a bare stream end, an operator's kill, or a pause. Deliberately not on the row's
  /// terminal status writes (fix round 1): the tally is a fact of the stream, while the row's
  /// conclusion is a fact of whoever won the race to write it, and those are different events --
  /// `packages/control/src/stop.ts` concludes an operator-stopped run with no tally in hand, and
  /// normally wins. A resumed run is a SECOND pump on this row, and MERGES into what is here
  /// rather than replacing it, which is what makes a pause -> resume total add up.
  ///
  /// THREE states, and the difference between the last two is Decision 4 (keyed on the run's
  /// PROVIDER, never on what the stream happened to contain):
  ///   - `{ "<skill>": n }` -- a Claude run that invoked skills.
  ///   - `{}`              -- a Claude run that invoked none. A MEASUREMENT: we watched, and
  ///                          there were none.
  ///   - `null`            -- a Cursor run, or a run whose stream has not ended yet. UNKNOWN:
  ///                          that runtime cannot report skill use at all, and an empty object
  ///                          there would claim a measurement nobody made.
  skillCalls        Json?
  /// Which runtime produced this run (M12 Task 6). Nullable: this task only adds the column --
  /// Tasks 7/8 resolve and write it, so every run recorded before them reads back null.
  provider          ProviderKind?
  pid               Int?
  worktreePath      String?
  startedAt         DateTime     @default(now())
  terminalAt        DateTime?
  endedAt           DateTime?

  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent      Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint?

  @@index([taskId])
  @@index([agentId, status])
}

model Checkpoint {
  id                String   @id @default(uuid())
  runId             String   @unique
  sessionId         String
  worktreePath      String
  pauseFlagPath     String
  lastToolUseId     String?
  lastToolName      String?
  numTurns          Int      @default(0)
  /// Unlike Workspace.verifyCommands/setupCommands, an empty array here is a perfectly ordinary
  /// value (no denials yet, no dirty files yet) rather than a refusal — so these two stay on
  /// Prisma's conventional nullable-array DDL rather than getting the NOT NULL enforcement above.
  deniedToolUseIds  String[]
  headCommit        String
  dirtyFiles        String[]
  cumulativeCostUsd Float    @default(0)
  cumulativeTokens  Int      @default(0)
  /// Fix round 1: the spawn-critical fields `resume()` cannot rediscover on its own, mirroring
  /// `packages/providers`' `Checkpoint` interface (see that file's docstring for the ruling this
  /// implements — ADR 0001 §5 puts `worktreePath` here for the same reason). Deliberately no
  /// `@default` on any of the four: the orchestrator always writes them, and a default would let
  /// a silently-incomplete checkpoint through the exact gate this task exists to close.
  settingsPath      String
  hookPath          String
  gitAuthorName     String
  gitAuthorEmail    String
  /// Free text: the operator-supplied reason that went into the hook's deny message, not the
  /// AgentRun.pauseReason category enum. Never assign an AgentRun.pauseReason enum member's
  /// literal spelling here — that would read as this field being the same enum when it is not.
  pauseReason       String?
  requestedBy       String?
  ts                DateTime @default(now())
  /// M10 §6: the model the run started with, written at start and replayed by `adapter.resume` --
  /// resume must continue with the SAME model, never whatever `setAgentModel` set most recently.
  /// A mid-run model change therefore affects only the NEXT run. Consumed starting Task 5.
  model             String?
  /// The provider the run started with (M12 Task 6), beside `model` for the same reason. Nullable
  /// -- this task only adds the column, Task 7/8 write and resolve it.
  provider          ProviderKind?

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Artifact {
  id        String   @id @default(uuid())
  taskId    String
  kind      String
  path      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model AgentMessage {
  id        String          @id @default(uuid())
  taskId    String?
  agentId   String
  category  MessageCategory
  body      String
  actor     Actor           @default(human)
  createdAt DateTime        @default(now())

  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model Approval {
  id        String   @id @default(uuid())
  taskId    String
  approved  Boolean
  reason    String?
  decidedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum EventType {
  task_created               @map("task.created")
  task_started               @map("task.started")
  task_done                  @map("task.done")
  task_rework                @map("task.rework")
  run_started                @map("run.started")
  run_tool_call              @map("run.tool_call")
  run_paused                 @map("run.paused")
  run_resumed                @map("run.resumed")
  run_resume_requested       @map("run.resume_requested")
  agent_message_sent         @map("agent.message_sent")
  guardrail_tripped          @map("guardrail.tripped")
  task_verifying             @map("task.verifying")
  task_verify_passed         @map("task.verify_passed")
  task_verify_failed         @map("task.verify_failed")
  task_failed                @map("task.failed")
  run_output                 @map("run.output")
  run_pause_requested        @map("run.pause_requested")
  run_stopped                @map("run.stopped")
  run_succeeded              @map("run.succeeded")
  run_failed                 @map("run.failed")
  run_tool_denied            @map("run.tool_denied")
  task_dependency_added      @map("task.dependency_added")
  task_dependency_removed    @map("task.dependency_removed")
  task_review_started        @map("task.review_started")
  task_review_approved       @map("task.review_approved")
  task_review_rejected       @map("task.review_rejected")
  task_merge_failed          @map("task.merge_failed")
  workspace_goal_set         @map("workspace.goal_set")
  workspace_plan_created     @map("workspace.plan_created")
  workspace_company_assigned @map("workspace.company_assigned")
  workspace_settings_changed @map("workspace.settings_changed")
  /// M23 A1: the first event a workspace ever logs, from `createWorkspace`.
  workspace_created          @map("workspace.created")
  /// M23 B2: `collectTaskWorktree` removed a terminal task's worktree -- aged out or by an
  /// operator's button.
  task_worktree_collected    @map("task.worktree_collected")
  /// M23 D1: an operator edited the roster -- `org.ts`'s five control verbs (rename/re-role/
  /// delete an agent, rename/delete a team) all emit this one type, distinguished by the
  /// payload's `field`.
  org_changed                @map("org.changed")
}

model ExecutionEvent {
  seq         BigInt    @id @default(autoincrement())
  ts          DateTime  @default(now())
  type        EventType
  workspaceId String
  taskId      String?
  agentId     String?
  runId       String?
  actor       Actor
  payload     Json

  @@index([workspaceId, seq])
  @@index([workspaceId, agentId, seq])
  @@index([workspaceId, taskId, seq])
  @@index([runId, seq])
}

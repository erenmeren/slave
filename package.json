{
  "name": "ai-team-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "tsc --build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && tsc -p packages/domain/tsconfig.test.json && tsc -p packages/db/tsconfig.test.json && tsc -p packages/events/tsconfig.test.json && tsc -p packages/control/tsconfig.test.json && tsc -p packages/providers/tsconfig.test.json && tsc -p apps/orchestrator/tsconfig.test.json && tsc -p tsconfig.tools.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/tsconfig.test.json",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma --config packages/db/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma --config packages/db/prisma.config.ts",
    "db:migrate:test": "node scripts/migrate-test.mjs",
    "db:seed": "tsc --build && node --env-file=.env packages/db/dist/seed.js",
    "db:seed:test": "tsc --build && node scripts/seed-test.mjs",
    "orchestrator": "tsc --build && node --env-file=.env apps/orchestrator/dist/cli.js",
    "web": "node --env-file=.env node_modules/next/dist/bin/next dev apps/web -H 127.0.0.1",
    "web:exposed": "node --env-file=.env node_modules/next/dist/bin/next dev apps/web -H 0.0.0.0",
    "web:build": "next build apps/web",
    "demo": "tsc --build && node --env-file=.env scripts/demo-live.mjs",
    "gate:m8a-merge": "tsc --build && node --env-file=.env scripts/gate-m8a-merge.mjs",
    "gate:m8a-estop": "tsc --build && node --env-file=.env scripts/gate-m8a-estop.mjs",
    "gate:m8-plan": "tsc --build && node --env-file=.env scripts/gate-m8-plan.mjs",
    "gate:m10-org": "tsc --build && node --env-file=.env scripts/gate-m10-org.mjs",
    "gate:m11-shell": "tsc --build && node --env-file=.env scripts/gate-m11-shell.mjs",
    "gate:m12-providers": "tsc --build && node --env-file=.env scripts/gate-m12-providers.mjs",
    "gate:m13-runtime": "tsc --build && node --env-file=.env scripts/gate-m13-runtime.mjs",
    "gate:m14-fidelity": "tsc --build && node --env-file=.env scripts/gate-m14-fidelity.mjs",
    "gate:m15-boundary": "tsc --build && node --env-file=.env scripts/gate-m15-boundary.mjs",
    "gate:m16-chrome": "tsc --build && node --env-file=.env scripts/gate-m16-chrome.mjs",
    "gate:m17-stability": "node scripts/gate-m17-stability.mjs",
    "gate:m18-skill-and-teeth": "tsc --build && node --env-file=.env scripts/gate-m18-skill-and-teeth.mjs",
    "gate:m19-measure-and-harden": "tsc --build && node --env-file=.env scripts/gate-m19-measure-and-harden.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild": true
  }
}

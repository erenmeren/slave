DATABASE_URL="postgresql://slaveofai:slaveofai@localhost:5433/slaveofai?schema=public"
TEST_DATABASE_URL="postgresql://slaveofai:slaveofai@localhost:5433/slaveofai_test?schema=public"

# Set to turn on local accounts: every page and API call then needs a signed-in user, and the app
# answers to non-loopback Host names (e.g. over Tailscale via `npm run web:exposed`).
# Mint one with `openssl rand -hex 32`; `npm run web:exposed` refuses anything under 32 characters.
# Create the first account with `npm run orchestrator -- create-user --name <you>`.
# Leave unset for the loopback-only default.
# SLAVEOFAI_SESSION_SECRET=
